# Unreal build output and editor caches (keep Source, Config, Content, and Build resources)
/.vs/
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/

# Project files regenerated by UnrealBuildTool
/*.sln
/*.slnx

# Regenerable caches inside plugins; vendor plugin binaries remain trackable
/Plugins/**/Intermediate/
/Plugins/**/Saved/
/Plugins/**/DerivedDataCache/

# Generated by Unreal Android packaging
/Build/Android_ASTC/FileOpenOrder/EditorOpenOrder.log
/Build/Android_ASTC/FileOpenOrder/CookerOpenOrder.log
/Build/Android_ASTC/ChunkLayerInfo/pakchunklayers.txt
/Build/Android/src/com/epicgames/unreal/DownloadShim.java
/Build/Android/src/com/test/mobilegame/AlarmReceiver.java
/Build/Android/src/com/test/mobilegame/DownloaderActivity.java
/Build/Android/src/com/test/mobilegame/OBBData.java
/Build/Android/src/com/test/mobilegame/OBBDownloaderService.java

# Backend dependencies and local secrets
/Backend/node_modules/
/Backend/.env
/Backend/.env.*
!/Backend/.env.example
